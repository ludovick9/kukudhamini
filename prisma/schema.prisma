generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FarmMembershipRole {
  OWNER
  MANAGER
  WORKER
}

enum BatchStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ExpensePaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  CREDIT
  OTHER
}

enum FeedType {
  STARTER
  GROWER
  FINISHER
}

enum FeedTransactionType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
}

enum HealthTaskType {
  MEDICINE
  VACCINATION
  OTHER
}

enum HealthTaskStatus {
  UPCOMING
  COMPLETED
  MISSED
  OVERDUE
}

enum SalePricingMode {
  PER_KG
  PER_BIRD
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  HEALTH
  FEED
  MORTALITY
  HARVEST
  FINANCE
  FARM_TASK
}

model User {
  id          String           @id @default(cuid())
  name        String
  email       String           @unique
  passwordHash String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships FarmMembership[]
  notifications Notification[]
  sessions    Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Farm {
  id              String           @id @default(cuid())
  name            String
  location        String
  currency        String           @default("TZS")
  timezone        String           @default("Africa/Dar_es_Salaam")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     FarmMembership[]
  batches         Batch[]
  expenseCategories ExpenseCategory[]
  suppliers       Supplier[]
  expenses        Expense[]
  feedProducts    FeedProduct[]
  feedTransactions FeedTransaction[]
  healthTasks     HealthTask[]
  mortalityRecords MortalityRecord[]
  customers       Customer[]
  sales           Sale[]
  payments        Payment[]
  notifications   Notification[]
}

model FarmMembership {
  id        String             @id @default(cuid())
  userId    String
  farmId    String
  role      FarmMembershipRole @default(WORKER)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  farm      Farm               @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, farmId])
  @@index([farmId])
  @@index([userId])
}

model Batch {
  id                 String           @id @default(cuid())
  farmId             String
  name               String
  breed              String
  arrivalDate        DateTime         @db.Date
  initialBirdCount   Int
  expectedHarvestDate DateTime        @db.Date
  status             BatchStatus      @default(ACTIVE)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  farm               Farm             @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  expenses           Expense[]
  feedTransactions   FeedTransaction[]
  healthTasks        HealthTask[]
  mortalityRecords   MortalityRecord[]
  sales              Sale[]
  notifications      Notification[]

  @@index([farmId])
  @@index([farmId, status])
  @@index([expectedHarvestDate])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  farmId    String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  farm      Farm      @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  expenses  Expense[]

  @@unique([farmId, name])
  @@index([farmId])
}

model Supplier {
  id               String            @id @default(cuid())
  farmId           String
  name             String
  phone            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  farm             Farm              @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  expenses         Expense[]
  feedTransactions FeedTransaction[]

  @@unique([farmId, name])
  @@index([farmId])
}

model Expense {
  id                String              @id @default(cuid())
  farmId            String
  batchId           String?
  categoryId        String
  supplierId        String?
  date              DateTime            @db.Date
  description       String
  quantity          Decimal             @db.Decimal(12, 3)
  unit              String
  unitPrice         Decimal             @db.Decimal(14, 2)
  totalAmount       Decimal             @db.Decimal(14, 2)
  paymentMethod     ExpensePaymentMethod
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  farm              Farm                @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  batch             Batch?              @relation(fields: [batchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  category          ExpenseCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier          Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([farmId, date])
  @@index([batchId])
  @@index([categoryId])
}

model FeedProduct {
  id               String            @id @default(cuid())
  farmId           String
  type             FeedType
  name             String
  lowStockThreshold Decimal           @db.Decimal(12, 3)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  farm             Farm              @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactions     FeedTransaction[]

  @@unique([farmId, type])
  @@index([farmId])
}

model FeedTransaction {
  id            String               @id @default(cuid())
  farmId        String
  batchId       String?
  productId     String
  supplierId    String?
  type          FeedTransactionType
  quantity      Decimal              @db.Decimal(12, 3)
  unit          String
  unitPrice     Decimal?             @db.Decimal(14, 2)
  date          DateTime             @db.Date
  notes         String?
  createdAt     DateTime             @default(now())
  farm          Farm                 @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  batch         Batch?               @relation(fields: [batchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  product       FeedProduct          @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier      Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([farmId, date])
  @@index([productId])
  @@index([batchId])
  @@index([type])
}

model HealthTask {
  id          String           @id @default(cuid())
  farmId      String
  batchId     String?
  title       String
  type        HealthTaskType
  scheduledAt DateTime
  instructions String?
  status      HealthTaskStatus @default(UPCOMING)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  farm        Farm             @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  batch       Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([farmId, scheduledAt])
  @@index([batchId])
  @@index([status])
  @@index([type])
}

model MortalityRecord {
  id        String   @id @default(cuid())
  farmId    String
  batchId   String
  date      DateTime @db.Date
  quantity  Int
  cause     String?
  notes     String?
  createdAt DateTime @default(now())
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([farmId, date])
  @@index([batchId, date])
}

model Customer {
  id        String   @id @default(cuid())
  farmId    String
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sales     Sale[]

  @@unique([farmId, name])
  @@index([farmId])
}

model Sale {
  id            String          @id @default(cuid())
  farmId        String
  batchId       String
  customerId    String?
  date          DateTime        @db.Date
  birdsSold     Int
  totalWeight   Decimal?        @db.Decimal(12, 3)
  pricingMode   SalePricingMode
  pricePerKg    Decimal?        @db.Decimal(14, 2)
  pricePerBird  Decimal?        @db.Decimal(14, 2)
  totalRevenue  Decimal         @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  farm          Farm            @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  batch         Batch           @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  payments      Payment[]

  @@index([farmId, date])
  @@index([batchId])
  @@index([customerId])
}

model Notification {
  id             String               @id @default(cuid())
  farmId         String
  userId         String?
  relatedBatchId String?
  type           NotificationType
  title          String
  message        String
  priority       NotificationPriority
  readAt         DateTime?
  createdAt      DateTime             @default(now())
  farm           Farm                 @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  relatedBatch   Batch?               @relation(fields: [relatedBatchId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([farmId, createdAt])
  @@index([userId, readAt])
  @@index([relatedBatchId])
  @@index([type])
  @@index([priority])
}

model Payment {
  id            String              @id @default(cuid())
  farmId        String
  saleId        String
  amount        Decimal             @db.Decimal(14, 2)
  paymentMethod ExpensePaymentMethod
  paymentDate   DateTime            @db.Date
  reference     String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  farm          Farm                @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sale          Sale                @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([farmId])
  @@index([saleId])
  @@index([paymentDate])
  @@index([paymentMethod])
}