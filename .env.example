# Server-only production/development database connection. Required in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Test-only database. It must be isolated and must never equal DATABASE_URL.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kukudhamini_test?schema=public"
TEST_BASE_URL="http://127.0.0.1:3100"

# Optional public origin used by redirects. Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL="http://localhost:3000"